{
  "manifest_version": 3,
  "name": "Scooby — AI Video Summarizer",
  "short_name": "Scooby",
  "description": "AI-powered transcript & audio summarizer. Paste any transcript or record live audio and get an instant summary using Mistral AI.",
  "version": "1.0.0",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Scooby Summarizer",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"]
}
